{
  "version": 2,
  "name": "toast-talent",
  "builds": [
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "^/api/(.*)$", "dest": "https://api.toasttalent.co.za/api/$1" },

    { "src": "^/$", "dest": "/public/index.html" },
    { "src": "^/models$", "dest": "/public/models.html" },
    { "src": "^/about$", "dest": "/public/about.html" },
    { "src": "^/contact$", "dest": "/public/contact.html" },
    { "src": "^/apply$", "dest": "/public/apply.html" },
    { "src": "^/promotions$", "dest": "/public/promotions.html" },

    { "src": "^/(.*)$", "dest": "/public/$1" }
  ]
}
